# Database
POSTGRES_DB=dic_db
POSTGRES_USER=dic_user
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_HOST=db
DB_PORT=5432
DB_NAME=dic_db
DB_USER=dic_user
DB_PASSWORD=your_password

# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=app.settings

# Хосты, с которых принимаются запросы. Из этого же списка собираются
# CORS_ALLOWED_ORIGINS и CSRF_TRUSTED_ORIGINS, поэтому при развёртывании
# сюда должен попасть внешний адрес сервера.
# На сервере это делает deploy.sh --server-host <IP>, вручную — допишите IP:
#   ALLOWED_HOSTS=2.26.22.168,localhost,127.0.0.1,backend
ALLOWED_HOSTS=localhost,127.0.0.1,backend

